    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 底衬：半透明深色圆角块，浅色背景上也看得见 -->
    <path
        android:fillColor="#CC181A23"
        android:pathData="M4,10 L10,4 L20,4 L20,14 L14,20 L4,20 Z" />

    <path
        android:pathData="M8,16 L16,8"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <path
        android:pathData="M12,16 L16,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
</vector>
