<?xml version="1.0" encoding="utf-8"?>
<!-- 长截图结果预览：上下滚动看，底部一排按钮 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:id="@+id/shot_preview_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:clipToPadding="false"
        android:scrollbars="vertical">

        <ImageView
            android:id="@+id/shot_preview_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/shot_long" />
    </ScrollView>

    <!-- 整图缩略条：一眼看到长图全貌，框里是当前可视范围，点一下跳过去 -->
    <LinearLayout
        android:id="@+id/shot_preview_thumbbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:background="@drawable/shot_toolbar_bg"
        android:padding="4dp"
        android:visibility="gone">

        <!-- ⚠ 宽度要写死 68dp：外层是 wrap_content + top|end，
             里面的 View/TextView 用 match_parent 会把整条缩略框撑成满宽，
             缩略图就被顶到屏幕左上角去了 -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/shot_preview_thumb"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@string/shot_long" />

            <View
                android:id="@+id/shot_preview_thumb_win"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="@drawable/thumb_window_bg" />
        </FrameLayout>

        <TextView
            android:id="@+id/shot_preview_size"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#E8E6DF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shot_preview_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:background="@drawable/shot_toolbar_bg"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/shot_preview_save"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/shot_btn_bg"
            android:contentDescription="@string/shot_save"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_shot_save"
            android:tint="#FFB454" />

        <ImageButton
            android:id="@+id/shot_preview_copy"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/shot_btn_bg"
            android:contentDescription="@string/shot_copy"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_shot_copy"
            android:tint="#E8E6DF" />

        <ImageButton
            android:id="@+id/shot_preview_pin"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/shot_btn_bg"
            android:contentDescription="@string/shot_pin"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_shot_pin"
            android:tint="#7EC8E3" />

        <ImageButton
            android:id="@+id/shot_preview_close"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/shot_btn_bg"
            android:contentDescription="@string/shot_cancel"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_shot_close"
            android:tint="#FF6B6B" />
    </LinearLayout>
</FrameLayout>
